<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <module name="TreeWalker">
        <!-- Custom security rule for PII in logs -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="log\..*\.(getEmail|getName|getTranscript)\(\)"/>
            <property name="message" value="SECURITY: Do not log PII (getEmail, getName, getTranscript)."/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
